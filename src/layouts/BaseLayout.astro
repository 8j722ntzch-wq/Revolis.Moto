---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import LeadDialog from '../components/LeadDialog.astro';
import { isSearchPage } from '../lib/seo';
interface Props { title: string; description: string; indexable?: boolean; }
const { title, description, indexable = true } = Astro.props;
const searchPage = isSearchPage(Astro.url.pathname);
const canonical = searchPage ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const allowIndex = import.meta.env.MODE === 'release' && searchPage && indexable;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndex ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/assets/icons/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/assets/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body><slot /><LeadDialog /><LeadDialog id="bank-dialog" kind="bank" /><LeadDialog id="thanks-dialog" kind="thanks" /></body>
</html>
