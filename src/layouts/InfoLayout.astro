---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MobileHeader from '../components/MobileHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/home.css';
import '../styles/home-mobile.css';
import '../styles/info-pages.css';
interface Props { title: string; description: string; pageClass?: string; }
const { title, description, pageClass } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div id="top" class:list={['homepage mobile-ui info-page', pageClass]}>
    <SiteHeader homeHref="/" actionHref="/contacts/" /><MobileHeader homeHref="/" actionHref="/contacts/" />
    <main><slot /></main>
    <div id="contacts"><SiteFooter /></div>
  </div>
</BaseLayout>
