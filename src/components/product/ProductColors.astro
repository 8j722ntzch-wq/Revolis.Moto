---
import { resolveProductColors, type ProductColorId } from '../../data/product-colors';
interface Props { colors?: readonly ProductColorId[]; selected?: ProductColorId; }
const colors = resolveProductColors(Astro.props.colors);
---
{colors.length > 0 && <div class="product-colors">
  <p class="product-colors__heading" id="product-colors-heading">Доступные цвета:</p>
  <ul class="product-colors__list" aria-labelledby="product-colors-heading">
    {colors.map(color => <li class="product-colors__item">
      <button type="button" data-product-color={color.id} aria-pressed={color.id === Astro.props.selected} class="product-colors__swatch" style={`--swatch-fill:${color.fill}`} aria-label={color.label}>
        {'image' in color && <span class="product-colors__pattern"><img src={color.image} alt="" /></span>}
        <span class="product-colors__name" aria-hidden="true">{color.label}</span>
      </button>
    </li>)}
  </ul>
</div>}
<style>
.product-colors { margin-top:24px; }
.product-colors__heading { font-size:14px; font-weight:600; line-height:1.3; letter-spacing:-.02em; }
.product-colors__list { display:flex; flex-wrap:wrap; gap:8px; padding:0; margin:8px 0 0; list-style:none; }
.product-colors__item { flex:none; }
.product-colors__swatch { border:0; padding:0; cursor:pointer; display:block; position:relative; width:40px; height:40px; border-radius:8px; background:var(--swatch-fill); }
.product-colors__swatch:focus-visible { outline:2px solid var(--color-purple); outline-offset:3px; }
.product-colors__pattern { display:grid; place-items:center; width:40px; height:40px; overflow:hidden; border-radius:8px; }
.product-colors__pattern img { max-width:none; transform:scaleY(-1); }
.product-colors__name { display:none; position:absolute; z-index:2; top:calc(100% + 4px); left:0; padding:4px 6px; border-radius:4px; background:var(--color-black); color:var(--color-white); font-size:12px; line-height:16px; white-space:nowrap; }
.product-colors__item:last-child .product-colors__name { left:auto; right:0; }
.product-colors__swatch:focus .product-colors__name { display:block; }
@media (hover:hover) and (pointer:fine) { .product-colors__swatch:hover .product-colors__name { display:block; } }
</style>

<style>.product-colors__swatch[aria-pressed="true"] { outline:2px solid var(--color-purple); outline-offset:3px; }</style>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-product-color]').forEach(button => {
  button.addEventListener('click', () => {
   const hero = button.closest('.product-hero');
   hero?.querySelectorAll<HTMLElement>('[data-media-color]').forEach(media => { media.hidden = media.dataset.mediaColor !== button.dataset.productColor; });
   hero?.querySelectorAll('[data-product-color]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
  });
 });
</script>
