---
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'text';
  size?: 's' | 'm' | 'xs';
  arrow?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: '_blank';
  'aria-label'?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, variant = 'solid', size = 's', arrow = false, disabled = false, type = 'button', class: className, target, ...attributes } = Astro.props;
if (variant !== 'text' && size !== 's') throw new Error('Only desktop size S is captured for solid/outline buttons.');
if (arrow && size !== 's') throw new Error('Only desktop 16px arrow is captured.');
const Tag = href ? (disabled ? 'span' : 'a') : 'button';
---
<Tag {...attributes} class:list={['ui-button', `ui-button--${variant}`, `ui-button--${size}`, className]} href={href && !disabled ? href : undefined} type={Tag === 'button' ? type : undefined} disabled={Tag === 'button' ? disabled : undefined} aria-disabled={disabled || undefined} target={!disabled ? target : undefined} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
  <span class="ui-button__label"><slot /></span>
  {arrow && <span class="ui-button__arrow" aria-hidden="true">
    <img class="arrow-black" src="/assets/ui/arrow-black.svg" alt="" />
    <img class="arrow-white" src="/assets/ui/arrow-white.svg" alt="" />
    <img class="arrow-purple" src="/assets/ui/arrow-purple.svg" alt="" />
    <img class="arrow-disabled" src="/assets/ui/arrow-disabled.svg" alt="" />
  </span>}
</Tag>
