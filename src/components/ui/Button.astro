---
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'text' | 'text-bold' | 'icon';
  size?: 's' | 'm' | 'l' | 'xs';
  tone?: 'default' | 'inverse';
  arrow?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  target?: '_blank';
  'aria-label'?: string;
  'aria-controls'?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, variant = 'solid', size = 's', tone = 'default', arrow = false, disabled = false, type = 'button', class: className, target, ...attributes } = Astro.props;
const sizes = { solid: ['s'], outline: ['s'], text: ['s', 'xs'], 'text-bold': ['s', 'l'], icon: ['s', 'm'] };
if (!sizes[variant].includes(size)) throw new Error(`Unsupported desktop Button: ${variant}/${size}.`);
if (tone === 'inverse' && !(variant === 'outline' || (variant === 'icon' && size === 'm'))) throw new Error('Inverse tone supports outline S and icon M from BankCard.');
if (size === 'm' && tone !== 'inverse') throw new Error('Icon M is currently implemented only for inverse tone.');
if (arrow && (size !== 's' || variant === 'text-bold' || variant === 'icon')) throw new Error('This Figma variant has no inline arrow.');
if (variant === 'icon' && !attributes['aria-label']) throw new Error('Icon buttons require an aria-label.');
const Tag = href ? (disabled ? 'span' : 'a') : 'button';
---
<Tag {...attributes} class:list={['ui-button', `ui-button--${variant}`, `ui-button--${size}`, { 'ui-button--with-arrow': arrow, 'ui-button--inverse': tone === 'inverse' }, className]} href={href && !disabled ? href : undefined} type={Tag === 'button' ? type : undefined} disabled={Tag === 'button' ? disabled : undefined} aria-disabled={disabled || undefined} target={!disabled ? target : undefined} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
  {variant !== 'icon' && <span class="ui-button__label"><slot /></span>}
  {tone === 'inverse' && (arrow || variant === 'icon') && <span class="ui-button__arrow" aria-hidden="true">
    <img class="inverse-rest" src={`/assets/ui/${variant === 'icon' ? 'angle' : 'arrow'}-inverse.svg`} alt="" />
    <img class="inverse-hover" src={`/assets/ui/${variant === 'icon' ? 'angle' : 'arrow'}-inverse-hover.svg`} alt="" />
  </span>}
  {tone !== 'inverse' && arrow && <span class="ui-button__arrow" aria-hidden="true">
    <img class="arrow-black" src="/assets/ui/arrow-black.svg" alt="" />
    <img class="arrow-white" src="/assets/ui/arrow-white.svg" alt="" />
    <img class="arrow-purple" src="/assets/ui/arrow-purple.svg" alt="" />
    <img class="arrow-disabled" src="/assets/ui/arrow-disabled.svg" alt="" />
  </span>}
  {tone !== 'inverse' && variant === 'icon' && <span class="ui-button__arrow" aria-hidden="true">
    <img class="angle-black" src="/assets/ui/angle-black.svg" alt="" />
    <img class="angle-white" src="/assets/ui/angle-white.svg" alt="" />
    <img class="angle-pressed" src="/assets/ui/angle-pressed.svg" alt="" />
    <img class="angle-disabled" src="/assets/ui/angle-disabled.svg" alt="" />
  </span>}
</Tag>
