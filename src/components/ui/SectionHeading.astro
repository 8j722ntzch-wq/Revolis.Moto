---
interface Props { eyebrow?: string; title: string; level?: 'h1' | 'h2' | 'h3'; id?: string; }
const { eyebrow, title, level: Heading = 'h2', id } = Astro.props;
---
<div class="section-heading">
  {eyebrow && <p class="type-eyebrow weight-bold">{eyebrow}</p>}
  <Heading id={id} class="section-heading__title">{title}</Heading>
</div>
