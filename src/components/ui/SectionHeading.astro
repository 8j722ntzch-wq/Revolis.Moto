---
interface Props { eyebrow?: string; title?: string; bold?: boolean; level?: 'h1' | 'h2' | 'h3'; id?: string; }
const { eyebrow, title, level: Heading = 'h2', id, bold = false } = Astro.props;
---
<div class="section-heading">
  {eyebrow && <p class="type-eyebrow weight-bold">{eyebrow}</p>}
  <Heading id={id} class:list={["section-heading__title", { "weight-bold": bold }]}><slot>{title}</slot></Heading>
</div>
