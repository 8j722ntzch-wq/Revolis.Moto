---
interface Props { eyebrow?: string; title: string; level?: 'h1' | 'h2' | 'h3'; size?: 'xl' | 'lg'; id?: string; }
const { eyebrow, title, level: Heading = 'h2', size = 'xl', id } = Astro.props;
---
<div class="section-heading">
  {eyebrow && <p class="type-eyebrow weight-bold">{eyebrow}</p>}
  <Heading id={id} class={`type-heading-${size}`}>{title}</Heading>
</div>
