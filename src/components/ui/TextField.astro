---
import { formatPhone, PHONE_MASK } from '../../lib/phone-mask';
interface Props {
  id: string; name: string; label: string; type?: 'text' | 'tel';
  value?: string; placeholder?: string; required?: boolean; disabled?: boolean;
  error?: string; autocomplete?: string; maxlength?: number; class?: string;
}
const { id, name, label, type = 'text', value, placeholder = label, required = false, disabled = false, error, autocomplete, maxlength, class: className } = Astro.props;
---
<div class:list={['text-field', className]}>
  <label class="sr-only" for={id}>{label}{required ? ' (обязательно)' : ''}</label>
  <div class="text-field__control">
    <input class="text-field__input" id={id} name={name} type={type} value={type === 'tel' && value ? formatPhone(value) : value} placeholder=" " required={required} disabled={disabled} aria-invalid={error ? 'true' : undefined} aria-describedby={error ? `${id}-error` : undefined} autocomplete={autocomplete} maxlength={maxlength} inputmode={type === 'tel' ? 'tel' : undefined} pattern={type === 'tel' ? String.raw`\+375 [0-9]{2}\-[0-9]{3}\-[0-9]{2}\-[0-9]{2}` : undefined} data-phone-mask={type === 'tel' || undefined} />
    <span class="text-field__placeholder" aria-hidden="true"><span class="text-field__label">{placeholder}{required && <span class="text-field__asterisk">*</span>}</span>{type === 'tel' && <span class="text-field__phone-hint">{PHONE_MASK}</span>}</span>
  </div>
  {error && <p class="text-field__error type-caption" id={`${id}-error`}>{error}</p>}
</div>
<script>
  import { bindPhoneMask } from '../../lib/phone-mask';
  document.querySelectorAll<HTMLInputElement>('[data-phone-mask]').forEach(bindPhoneMask);
</script>
