---
import LeadForm from './LeadForm.astro';
import Button from './ui/Button.astro';
import CloseButton from './ui/CloseButton.astro';
import '../styles/popups.css';
interface Props { id?: string; policyUrl?: string; kind?: 'consultation' | 'bank' | 'thanks'; }
const { id = 'lead-dialog', policyUrl = '/privacypolicy/', kind = 'consultation' } = Astro.props;
---
<dialog id={id} class:list={['lead-dialog', `lead-dialog--${kind}`]} data-lead-dialog aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`}>
  <div class="lead-dialog__content">
    <CloseButton />
    <div class="lead-dialog__heading">
      <h2 id={`${id}-title`} tabindex="-1" autofocus>{kind === 'thanks' ? <><span>Благодарим</span> за оставление заявки!</> : kind === 'bank' ? <><span>Подберём</span> удобный вариант оплаты</> : <><span>Поможем</span> выбрать квадроцикл</>}</h2>
      <p id={`${id}-description`}>{kind === 'thanks' ? 'Наш менеджер свяжется с вами в ближайшее время' : kind === 'bank' ? 'Поможем узнать условия кредита или рассрочки от банков-партнёров' : 'Оставьте контакты — обсудим модели, комплектацию и условия покупки'}</p>
    </div>
    {kind === 'thanks' ? <>
      <div class="lead-dialog__processing"><p>Ваша заявка находится в обработке</p><div class="lead-dialog__progress" aria-hidden="true"><span></span><span></span></div></div>
      <Button href="/" arrow>Вернуться на главную</Button>
    </> : <LeadForm id={`${id}-form`} source="dialog" intent={kind === 'bank' ? 'finance' : 'consultation'} policyUrl={policyUrl} bankSelection={kind === 'bank'} />}
    {kind === 'bank' && <p class="lead-dialog__bank-note">Условия и решение по финансированию принимает банк</p>}
  </div>
</dialog>
<script>
  import '../lib/dialogs';
</script>
