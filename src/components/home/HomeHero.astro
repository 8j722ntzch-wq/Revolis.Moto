---
import { imageAttrs } from "../../lib/responsive-images";
import Button from '../ui/Button.astro';
import Advantage from './AdvantageItem.astro';
---
<section class="home-hero container" aria-labelledby="hero-title">
  <div class="home-hero__mobile-image mobile-only" aria-hidden="true"><img {...imageAttrs("/assets/mobile-home/hero.png", "banner")} alt="" fetchpriority="high" /></div>
  <img class="home-hero__image" {...imageAttrs("/assets/home/hero.png", "banner")} alt="Квадроцикл на фоне горного пейзажа" width="1193" height="683" fetchpriority="high" />
  <div class="home-hero__copy">
    <p class="home-eyebrow">Официальный дилер в Беларуси</p>
    <h1 id="hero-title">Квадроциклы<br /> и вездеходы<br /> <span>в Беларуси</span></h1>
    <p class="home-hero__body">BaltMotors и Mikilon. Сертифицированная<br /> техника с гарантией до 3 лет, документами<br /> для регистрации и гибкими вариантами оплаты</p>
    <div class="home-actions"><Button href="/models/" arrow>Смотреть модели</Button><Button data-open-lead="lead-dialog" data-source="hero" data-intent="consultation" variant="outline" arrow>Запросить консультацию</Button></div>
  </div>
  <div class="home-hero__uses" aria-label="Для работы, отдыха и новых маршрутов">
    <img class="home-hero__uses-line" src="/assets/home/usage-line.svg" alt="" />
    {[['work', 'Для работы'], ['rest', 'Для отдыха'], ['route', 'Для новых маршрутов']].map(([icon, label]) => <p><img class="home-hero__dot" src="/assets/home/usage-dot.svg" alt="" /><img src={`/assets/home/usage-${icon}.svg`} alt="" width="32" height="32" /><span>{label}</span></p>)}
  </div>
  <div class="home-hero__advantages">
    <Advantage icon="benefit-documents" title="Официальное оформление">Получение ПТС или ПСМ</Advantage>
    <Advantage icon="benefit-warranty" title="Гарантия до 3 лет">Гарантийные условия производителя</Advantage>
    <Advantage icon="benefit-finance" title="Кредит и рассрочка">Альфа-Банк и Технобанк</Advantage>
    <Advantage icon="benefit-test" title="Тест-драйв">Скидка при покупке на сумму тест-драйва</Advantage>
  </div>
</section>
