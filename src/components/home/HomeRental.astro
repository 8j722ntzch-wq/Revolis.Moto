---
import Button from '../ui/Button.astro';
import Advantage from './AdvantageItem.astro';
---
<section id="rental" class="home-rental container" aria-labelledby="rental-title">
  <div class="mobile-only mobile-pattern mobile-pattern--rental" aria-hidden="true">{[[2,220,312],[1,220,418.667],[3,220,525.334],[2,-100,418.667],[1,-100,525.334],[2,-420,525.334]].map(([n,x,y]) => <img src={`/assets/mobile-home/rental-key-${n}.svg`} alt="" style={`left:${x}px;top:${y}px`} />)}</div><img class="home-rental__pattern" src="/assets/home/rental-pattern.svg" alt="" />
  <div class="home-rental__copy"><p class="home-eyebrow">Наш опыт — собственный прокат</p><h2 id="rental-title">Знаем квадроциклы<br /> <span>по реальной эксплуатации</span></h2><p class="home-banner__body">Используем квадроциклы в прокате и знаем, что требует внимания на маршруте и при обслуживании. Этот опыт помогает нам обсуждать с вами выбор и дальнейшую эксплуатацию техники.</p><Button class="home-rental__button" arrow disabled>Узнать о прокате</Button></div>
  <div class="home-rental__sticker" role="img" aria-label="Зубр и аист на квадроцикле">
    <img class="home-rental__sticker-outline" src="/assets/home/rental-sticker-outline.svg" alt="" loading="lazy" />
    <img class="home-rental__sticker-art" src="/assets/home/rental-sticker-art.svg" alt="" loading="lazy" />
  </div>
  <div class="home-rental__advantages"><Advantage icon="rental-route" title="Маршруты на природе">Условия поездки обсудим заранее</Advantage><Advantage icon="rental-safe" title="Подготовка к поездке">Уточните экипировку и инструктаж при записи</Advantage><Advantage icon="rental-group" title="Формат участия">Согласуем состав группы и время</Advantage><Advantage icon="rental-gift" title="Запись в прокат">Уточните доступные даты и условия</Advantage></div>
</section>
