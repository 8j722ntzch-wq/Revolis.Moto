---
import Advantage from './AdvantageItem.astro';
import { footerContent } from '../../data/footer';
---
<section class="home-highlights container" aria-label="Опыт и магазин">
  <div class="home-highlights__reach"><div class="home-highlights__count"><p>100+</p><span>Клиентов оценили нашу технику на лесных маршрутах</span></div><img src="/assets/home/belarus.svg" alt="" width="80" height="80" /><div class="home-highlights__country"><p>Работаем<br />по всей стране</p><span>Доставка<br />и поддержка</span></div></div>
  <div class="home-highlights__shop"><img class="home-decoration" src="/assets/home/address-pattern.svg" alt="" /><Advantage icon="shop-white" title="Магазин в Витебске">По адресу:<br />пр-т Московский, 111</Advantage><div class="home-hours">{footerContent.hours.map(row => <p><strong>{row.label}</strong><span>{row.value}</span></p>)}</div></div>
</section>
