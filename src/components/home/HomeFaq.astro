---
import SectionHeading from '../ui/SectionHeading.astro';
import FaqItem from '../FaqItem.astro';
const questions = ['Можно ли ездить на квадроцикле по дорогам общего пользования?', 'Можно ли купить квадроцикл в кредит или рассрочку?', 'Какая гарантия предоставляется на квадроциклы?', 'Можно ли пройти тест-драйв перед покупкой?', 'Осуществляется ли доставка квадроциклов по Беларуси?'];
const answers = [
  'Всё зависит от модели и категории транспортного средства. Квадрициклы Baltmotors предусматривают регистрацию в ГАИ, а модели Mikilon — в Гостехнадзоре. Возможность движения по дорогам общего пользования определяется документами и установленными правилами эксплуатации. Поможем разобраться в особенностях выбранной техники.',
  'Да, мы сотрудничаем с Альфа-Банком и Технобанком. Поможем подобрать доступную программу кредитования или рассрочки, рассчитать ориентировочные платежи и подготовить заявку. Условия финансирования зависят от выбранной программы и решения банка.',
  'Гарантийный срок зависит от производителя и модели. Для Baltmotors предусмотрена гарантия до 3 лет, для Mikilon — 12 месяцев. При покупке предоставляем гарантийные документы и консультируем по вопросам обслуживания и ремонта техники.',
  'Да, отдельные модели доступны для тест-драйва по предварительной записи. Стоимость одного часа — 150 BYN. При последующей покупке квадроцикла предоставляем скидку 150 BYN на согласованных условиях. Доступные модели и условия участия уточняются при записи.',
  'Да, мы организуем доставку техники в разные регионы Беларуси. Стоимость и сроки рассчитываются индивидуально с учётом модели и адреса доставки. Перед отправкой согласуем порядок оплаты, передачи техники и необходимых документов.',
];
---
<section id="faq" class="home-faq container" aria-labelledby="faq-title">
  <SectionHeading eyebrow="ВОПРОСЫ И ОТВЕТЫ" id="faq-title" bold>Всё, что <span>важно знать</span> перед покупкой</SectionHeading>
  <div class="home-faq__items">
    {questions.map((question, index) => <FaqItem question={question} group="homepage-faq"><p>{answers[index]}</p></FaqItem>)}
  </div>
</section>
