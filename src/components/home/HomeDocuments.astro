---
import { imageAttrs } from "../../lib/responsive-images";
import SectionHeading from '../ui/SectionHeading.astro';
import CardRail from './CardRail.astro';
---
<section id="about" class="home-documents container" aria-labelledby="documents-title">
  <SectionHeading eyebrow="До покупки" id="documents-title" bold>Разберём документы<br /> <span>на выбранную технику</span></SectionHeading>
  <CardRail id="documents-rail" label="Документы — листайте горизонтально" previousLabel="Предыдущий документ" nextLabel="Следующий документ">
    <article class="home-document"><img src="/assets/home/doc-gost.svg" alt="" width="56" height="56" /><div><h3>Документы<br />на модель</h3><p>Покажем документы выбранного исполнения и объясним, какие сведения важны при покупке.</p></div><img class="home-document__image" {...imageAttrs("/assets/home/certificate.png", "banner")} alt="Сертификат соответствия из макета" width="360" height="360" loading="lazy" /></article>
    <article class="home-document"><img src="/assets/home/doc-supply.svg" alt="" width="56" height="56" /><div><h3>Комплектация<br />и передача</h3><p>Согласуем, что входит в предложение и какие документы передаются с техникой.</p></div><div class="home-document__empty" aria-hidden="true"></div></article>
    <article class="home-document home-document--purple"><img src="/assets/home/doc-registration.svg" alt="" width="56" height="56" /><div><h3>Порядок<br />регистрации</h3><p>Разберём оформление выбранной модели по её документам и требованиям Беларуси.</p></div><img class="home-document__image" {...imageAttrs("/assets/home/registration-documents.png", "banner")} alt="Образцы документов для регистрации" width="360" height="360" loading="lazy" /></article>
  </CardRail>
</section>
