---
import Button from '../ui/Button.astro';
---
<section id="test-drive" class="home-test container home-banner" aria-labelledby="test-title">
  <div class="mobile-only mobile-pattern mobile-pattern--test" aria-hidden="true">{[3,1,2].map((n,i) => <img src={`/assets/mobile-home/test-key-${n}.svg`} alt="" style={`--tile:${i}`} />)}</div><div class="mobile-only home-test__mobile-photos" aria-hidden="true"><div class="mobile-test-photo mobile-test-photo--left"><img src="/assets/mobile-home/test-left.png" alt="" loading="lazy" /></div><div class="mobile-test-photo mobile-test-photo--right"><img src="/assets/mobile-home/test-right.png" alt="" loading="lazy" /></div></div><img class="home-decoration" src="/assets/home/test-pattern.svg" alt="" />
  <div class="home-test__photos" aria-label="Лесной маршрут тест-драйва"><div class="home-test__shade home-test__shade--left"></div><div class="home-test__shade home-test__shade--right"></div><div class="home-test__shade home-test__shade--front"></div><img class="home-test__photo--left" src="/assets/home/test-photo-left.png" alt="Участники тест-драйва в лесу" width="277" height="367" loading="lazy" /><img class="home-test__photo--right" src="/assets/home/test-photo-right.png" alt="Поездка на квадроцикле" width="281" height="369" loading="lazy" /><img class="home-test__photo--front" src="/assets/home/test-photo-front.png" alt="Квадроциклы на лесном маршруте" width="244" height="344" loading="lazy" /></div>
  <div class="home-banner__copy"><p class="home-eyebrow">Тест-драйв</p><h2 id="test-title">Попробуйте квадроцикл<br /> перед покупкой</h2><p class="home-banner__body">Пройдите подготовленный лесной маршрут, оцените управление, возможности и эмоции от техники</p><Button class="home-test__button" href="#contacts" arrow>Записаться на тест-драйв</Button></div>
  <img class="home-test__handwriting" src="/assets/home/test-handwriting.png" alt="150 BYN тест-драйв = 150 BYN скидка при покупке" width="237" height="119" loading="lazy" />
  <div class="home-test__advantages"><p><img src="/assets/home/test-discount.svg" alt="" />Скидка на сумму тест-драйва</p><p><img src="/assets/home/test-route.svg" alt="" />Лесной маршрут</p></div>
</section>
