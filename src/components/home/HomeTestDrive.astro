---
import { imageAttrs } from "../../lib/responsive-images";
import Button from '../ui/Button.astro';
---
<section id="test-drive" class="home-test container home-banner" aria-labelledby="test-title">
  <div class="mobile-only mobile-pattern mobile-pattern--test" aria-hidden="true">{[3,1,2].map((n,i) => <img src={`/assets/mobile-home/test-key-${n}.svg`} alt="" style={`--tile:${i}`} />)}</div><div class="mobile-only home-test__mobile-photos" aria-hidden="true"><div class="mobile-test-photo mobile-test-photo--left"><img {...imageAttrs("/assets/mobile-home/test-left.png", "banner")} alt="" loading="lazy" /></div><div class="mobile-test-photo mobile-test-photo--right"><img {...imageAttrs("/assets/mobile-home/test-right.png", "banner")} alt="" loading="lazy" /></div></div><img class="home-decoration" src="/assets/home/test-pattern.svg" alt="" />
  <div class="home-test__photos" aria-label="Лесной маршрут тест-драйва"><div class="home-test__shade home-test__shade--left"></div><div class="home-test__shade home-test__shade--right"></div><div class="home-test__shade home-test__shade--front"></div><img class="home-test__photo--left" {...imageAttrs("/assets/home/test-photo-left.png", "banner")} alt="Участники тест-драйва в лесу" width="277" height="367" loading="lazy" /><img class="home-test__photo--right" {...imageAttrs("/assets/home/test-photo-right.png", "banner")} alt="Поездка на квадроцикле" width="281" height="369" loading="lazy" /><img class="home-test__photo--front" {...imageAttrs("/assets/home/test-photo-front.png", "banner")} alt="Квадроциклы на лесном маршруте" width="244" height="344" loading="lazy" /></div>
  <div class="home-banner__copy"><p class="home-eyebrow">Тест-драйв перед покупкой</p><h2 id="test-title">Почувствуйте квадроцикл{' '}<br />на лесном маршруте</h2><p class="home-banner__body">Поездка с экипировкой по подготовленному маршруту поможет оценить посадку и управление. Доступные модели и условия согласуем при записи.</p><Button class="home-test__button" data-open-lead="lead-dialog" data-source="test-drive" data-intent="test-drive" arrow>Записаться на тест-драйв</Button></div>
  <p class="home-test__note">Оцените технику<br /> до покупки</p>
  <div class="home-test__advantages"><p><img src="/assets/home/test-discount.svg" alt="" />Экипировка для поездки</p><p><img src="/assets/home/test-route.svg" alt="" />Подготовленный лесной маршрут</p></div>
</section>
