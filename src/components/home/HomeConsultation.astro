---
import Button from '../ui/Button.astro';
import Advantage from './AdvantageItem.astro';
---
<section id="consultation" class="home-consultation home-banner container" aria-labelledby="consultation-title">
  <img class="home-consultation__photo" src="/assets/home/consultation.png" alt="Квадроцикл на горной дороге" width="732" height="440" loading="lazy" />
  <div class="home-consultation__gradient"></div><img class="home-decoration" src="/assets/home/cta-pattern.svg" alt="" />
  <div class="home-banner__copy"><p class="home-eyebrow">Подберём идеальный вариант</p><h2 id="consultation-title">Не знаете, <span>какой</span><br />квадроцикл <span>выбрать?</span></h2><p class="home-banner__body">Расскажите о своих задачах — поможем подобрать модель, рассчитаем условия покупки и ответим<br />на все вопросы</p><Button href="#contacts" arrow>Получить консультацию</Button></div>
  <Advantage class="home-consultation__address" icon="cta-shop" title="Ждём Вас в магазине">По адресу: Витебск, пр-т Московский, 111</Advantage>
</section>
