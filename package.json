{
  "name": "revolis-moto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "node scripts/clean-build.mjs && astro build && node scripts/check-public-build.mjs",
    "preview": "astro preview",
    "design:status": "node scripts/check-design-inputs.mjs",
    "design:check": "node scripts/check-design-inputs.mjs --strict",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:homepage": "node scripts/export-ui-kit.mjs --homepage",
    "export:catalogue": "node scripts/export-ui-kit.mjs --catalogue",
    "export:contacts": "node scripts/export-ui-kit.mjs --page=contacts",
    "export:privacy": "node scripts/export-ui-kit.mjs --page=privacy",
    "export:404": "node scripts/export-ui-kit.mjs --page=404",
    "export:sku": "node scripts/export-ui-kit.mjs --sku=baltmotors-500-efi-eps",
    "images:prepare": "node scripts/prepare-images.mjs",
    "build:release": "node scripts/clean-build.mjs && astro build --mode release && node scripts/check-public-build.mjs --release"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
