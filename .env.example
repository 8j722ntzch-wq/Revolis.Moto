# Set a same-origin HTTPS server endpoint only after it has been implemented.
# No Telegram/CRM secrets belong in PUBLIC_ variables or browser code.
PUBLIC_LEAD_ENDPOINT=/api/leads.php
# The PDF is linked in forms and the footer without enabling submission.
# After backend setup, set this to /documents/personal-data-policy-2026-11-04.pdf
# to activate delivery, then verify a real submission.
PUBLIC_PERSONAL_DATA_POLICY_URL=
